# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ib_assistant

# ===== AI 引擎（OpenAI 兼容接口）=====
# 引擎 1：Ark（豆包）— 主引擎
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-1.5-pro-32k

# 引擎 2：DeepSeek — 备选引擎
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== JWT =====
SECRET_KEY=ib-assistant-secret-key-change-me

# ===== 注册邮箱验证 =====
EMAIL_VERIFICATION_CODE_TTL_SECONDS=600
EMAIL_VERIFICATION_PROOF_TTL_SECONDS=900
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_EMAIL_LIMIT_PER_HOUR=5
EMAIL_VERIFICATION_IP_LIMIT_PER_HOUR=20

# ===== SMTP 邮件发送 =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=IB Deadline Assistant
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# ===== 日历提醒（后端）=====
APP_BASE_URL=http://localhost:5173
REMINDER_WORKER_INTERVAL_SECONDS=60
# 0 = 当前不限制；仍记录 provider 返回的实际 token 使用量
LLM_MONTHLY_TOKEN_QUOTA=0

# ===== 用户日历负载均衡（后端 MVP，默认关闭）=====
SCHEDULING_BALANCER_ENABLED=false

# QQ Mail 示例（仅填写非秘密配置；账号和授权码只放本地 .env/secret store）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USE_STARTTLS=false
# SMTP_USE_SSL=true
