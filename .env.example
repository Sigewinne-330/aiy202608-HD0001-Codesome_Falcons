# ===== 数据库 =====
DB_PASSWORD=change-me
DB_NAME=ib_assistant
DB_PORT=3306

# ===== JWT =====
SECRET_KEY=change-me-to-a-random-string

# ===== ManageBac iCal 凭据加密 =====
# 使用 Fernet.generate_key() 生成，不能与 SECRET_KEY 共用。
INTEGRATION_CREDENTIAL_KEY=
MANAGEBAC_SYNC_INTERVAL_MINUTES=10
MANAGEBAC_HTTP_TIMEOUT_SECONDS=15
MANAGEBAC_MAX_FEED_BYTES=5242880
MANAGEBAC_ALLOWED_HOST_SUFFIXES=managebac.com,managebac.cn

# ===== 后台提醒 Worker（邮件参数可按需配置）=====
APP_BASE_URL=http://localhost
REMINDER_WORKER_INTERVAL_SECONDS=60
LLM_MONTHLY_TOKEN_QUOTA=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=IBuddy
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false

# ===== AI 引擎（至少配一个）=====
ARK_API_KEY=
DEEPSEEK_API_KEY=

# ===== 前端端口 =====
APP_PORT=8081
